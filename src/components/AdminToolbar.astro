---
// AdminToolbar: fixed bottom bar visible only to admin — global save/cancel
---

<div id="admin-toolbar" class="hidden fixed bottom-0 inset-x-0 z-40 border-t border-gray-200 bg-white/95 backdrop-blur px-4 py-3 shadow-lg dark:border-gray-700 dark:bg-gray-900/95">
  <div class="mx-auto flex max-w-6xl items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
        관리자 모드
      </span>
      <span id="admin-pending-badge" class="hidden inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
        <span id="admin-pending-count">0</span>개 변경 대기
      </span>
    </div>
    <div class="flex items-center gap-2">
      <button
        id="admin-unknown-terms-btn"
        type="button"
        class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-sm font-medium text-amber-700 hover:bg-amber-100 dark:border-amber-600 dark:bg-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-900/50 transition-colors"
      >
        미확인 용어 <span id="admin-unknown-count" class="ml-1 inline-flex items-center justify-center rounded-full bg-amber-200 px-1.5 text-xs font-bold text-amber-800 dark:bg-amber-800 dark:text-amber-200">0</span>
      </button>
      <button
        id="admin-add-term-btn"
        type="button"
        class="rounded-lg border border-green-300 bg-green-50 px-3 py-1.5 text-sm font-medium text-green-700 hover:bg-green-100 dark:border-green-600 dark:bg-green-900/30 dark:text-green-300 dark:hover:bg-green-900/50 transition-colors"
      >
        + 용어 추가
      </button>
      <button
        id="admin-batch-save-btn"
        type="button"
        class="rounded-lg border border-blue-300 bg-blue-50 px-3 py-1.5 text-sm font-medium text-blue-700 hover:bg-blue-100 dark:border-blue-600 dark:bg-blue-900/30 dark:text-blue-300 dark:hover:bg-blue-900/50 transition-colors"
      >
        일괄 저장
      </button>
      <button
        id="admin-deploy-btn"
        type="button"
        class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-800 transition-colors"
      >
        사이트 반영
      </button>
    </div>
  </div>
</div>

<script>
  import { onAdminChange } from '../lib/authStore';
  import { getSupabase } from '../lib/supabaseClient';
  import { initAdminEnhancer, saveAllModifiedRows } from '../lib/adminEnhancer';
  import * as api from '../lib/adminApi';
  import type { UnknownTermEntry } from '../lib/adminApi';
  import { fetchTerms, fetchCategories, buildSubcategoryMap, SUPABASE_ANON_KEY } from '../lib/dataStore';

  const toolbar = document.getElementById('admin-toolbar')!;
  const unknownTermsBtn = document.getElementById('admin-unknown-terms-btn')!;
  const unknownCountBadge = document.getElementById('admin-unknown-count')!;
  const addTermBtn = document.getElementById('admin-add-term-btn')!;
  const batchSaveBtn = document.getElementById('admin-batch-save-btn')!;
  const deployBtn = document.getElementById('admin-deploy-btn')!;

  // Show/hide toolbar based on admin state
  onAdminChange(async (isAdmin) => {
    if (isAdmin) {
      toolbar.classList.remove('hidden');
      document.body.style.paddingBottom = '80px';
      // Load pending unknown terms count
      try {
        const pending = await api.fetchUnknownTerms('pending');
        unknownCountBadge.textContent = String(pending.length);
      } catch { /* ignore — badge stays 0 */ }
    } else {
      toolbar.classList.add('hidden');
      document.body.style.paddingBottom = '';
    }
  });

  // Initialize admin DOM enhancer
  initAdminEnhancer();

  // Batch save all modified rows
  batchSaveBtn.addEventListener('click', async () => {
    const modifiedCount = document.querySelectorAll('.admin-row-modified').length;
    if (modifiedCount === 0) {
      showToast('변경된 항목이 없습니다.');
      return;
    }
    batchSaveBtn.textContent = '저장 중...';
    batchSaveBtn.setAttribute('disabled', 'true');
    batchSaveBtn.classList.add('opacity-50', 'cursor-not-allowed');
    try {
      const { saved, errors } = await saveAllModifiedRows();
      if (errors > 0) {
        showToast(`${saved}개 저장, ${errors}개 실패`, true);
      } else {
        showToast(`${saved}개 항목이 저장되었습니다.`);
      }
    } catch (err) {
      showToast(`오류: ${(err as Error).message}`, true);
    } finally {
      batchSaveBtn.textContent = '일괄 저장';
      batchSaveBtn.removeAttribute('disabled');
      batchSaveBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
  });

  // Add new term dialog
  addTermBtn.addEventListener('click', async () => {
    const [terms, categories] = await Promise.all([fetchTerms(), fetchCategories()]);
    const subcatMap = buildSubcategoryMap(terms, categories);
    const sorted = [...categories].sort((a, b) => a.order - b.order);

    const backdrop = document.createElement('div');
    backdrop.className = 'fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4';

    let catOptions = sorted.map((c) => `<option value="${c.code}">${c.name}</option>`).join('');

    backdrop.innerHTML = `
      <div class="w-full max-w-md rounded-xl bg-white p-6 shadow-2xl dark:bg-gray-800 max-h-[80vh] overflow-y-auto">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">새 용어 추가</h3>
        <form class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">용어 (ID)</label>
            <input name="id" type="text" required placeholder="드나"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">풀네임</label>
            <input name="full_name" type="text" placeholder="드래곤 나이트 (Dragon Knight)"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">카테고리</label>
            <select name="category" required
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100">
              ${catOptions}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">소분류</label>
            <input name="subcategory" type="text" placeholder="(선택) 2차 직업"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">설명</label>
            <textarea name="description" rows="2" placeholder="소드맨 2차"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 resize-y"></textarea>
          </div>
          <div class="flex gap-2 pt-1">
            <button type="submit" class="flex-1 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors">추가</button>
            <button type="button" class="admin-dialog-cancel flex-1 rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 dark:border-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">취소</button>
          </div>
        </form>
      </div>
    `;

    document.body.appendChild(backdrop);

    const form = backdrop.querySelector('form')!;
    const cancelBtn = backdrop.querySelector('.admin-dialog-cancel')!;

    cancelBtn.addEventListener('click', () => backdrop.remove());
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) backdrop.remove();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const id = (fd.get('id') as string).trim();
      try {
        await api.createTerm({
          id,
          term: id,
          full_name: (fd.get('full_name') as string) || '',
          category: fd.get('category') as string,
          subcategory: (fd.get('subcategory') as string) || '',
          description: (fd.get('description') as string) || '',
          tags: [id],
        });
        backdrop.remove();
        // Show toast
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-50 rounded-lg px-4 py-2 text-sm font-medium shadow-lg bg-gray-800 text-white dark:bg-gray-200 dark:text-gray-900 transition-opacity duration-300';
        toast.textContent = '용어가 추가되었습니다. 페이지를 새로고침하면 반영됩니다.';
        document.body.appendChild(toast);
        setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 2500);
      } catch (err) {
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-50 rounded-lg px-4 py-2 text-sm font-medium shadow-lg bg-red-600 text-white transition-opacity duration-300';
        toast.textContent = `오류: ${(err as Error).message}`;
        document.body.appendChild(toast);
        setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 2500);
      }
    });
  });

  // Deploy button — trigger rebuild via Edge Function
  function showToast(message: string, isError = false) {
    const toast = document.createElement('div');
    toast.className = `fixed bottom-20 left-1/2 -translate-x-1/2 z-50 rounded-lg px-4 py-2 text-sm font-medium shadow-lg transition-opacity duration-300 ${
      isError
        ? 'bg-red-600 text-white'
        : 'bg-gray-800 text-white dark:bg-gray-200 dark:text-gray-900'
    }`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  deployBtn.addEventListener('click', async () => {
    if (!confirm('사이트를 재배포하시겠습니까? (약 1~2분 소요)')) return;

    const supabase = await getSupabase();
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.access_token) {
      showToast('배포 트리거 실패: 로그인 세션이 없습니다.', true);
      return;
    }

    // Disable button while request is in progress
    const originalText = deployBtn.textContent;
    deployBtn.textContent = '배포 중...';
    deployBtn.setAttribute('disabled', 'true');
    deployBtn.classList.add('opacity-50', 'cursor-not-allowed');

    try {
      const res = await fetch(
        'https://nyftkqzrbanrxcoaxzke.supabase.co/functions/v1/trigger-rebuild',
        {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${session.access_token}`,
            apikey: SUPABASE_ANON_KEY,
            'Content-Type': 'application/json',
          },
        },
      );

      const data = await res.json();

      if (res.ok && data.ok) {
        showToast('배포가 트리거되었습니다. 약 1~2분 후 반영됩니다.');
      } else {
        const errMsg = data.error || `HTTP ${res.status}`;
        showToast(`배포 트리거 실패: ${errMsg}`, true);
        // Fallback: show manual instructions
        console.warn(
          '[AdminToolbar] 배포 트리거 실패. 수동 실행: gh workflow run deploy.yml --ref master',
        );
      }
    } catch (err) {
      showToast(`배포 트리거 실패: ${(err as Error).message}`, true);
      console.warn(
        '[AdminToolbar] 네트워크 오류. 수동 실행: gh workflow run deploy.yml --ref master',
      );
    } finally {
      // Re-enable button
      deployBtn.textContent = originalText;
      deployBtn.removeAttribute('disabled');
      deployBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
  });

  // =========================================================================
  // Unknown Terms Panel
  // =========================================================================

  const CATEGORY_LABELS: Record<string, string> = {
    job: '직업 약칭', 'job-build': '직업 빌드/역할', gear: '장비·아이템',
    'gear-prefix': '장비 접두어', 'gear-consumable': '소비 아이템',
    system: '시스템·메카닉', stat: '스탯·수치', place: '사냥터·콘텐츠',
    slang: '커뮤니티 은어', notation: '숫자·기호 표기법', history: '게임 역사·문화',
  };

  const STATUS_LABELS: Record<string, string> = {
    pending: '대기', approved: '승인', rejected: '거부',
  };

  const STATUS_COLORS: Record<string, string> = {
    pending: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    approved: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
    rejected: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
  };

  async function refreshUnknownCount(): Promise<void> {
    try {
      const pending = await api.fetchUnknownTerms('pending');
      unknownCountBadge.textContent = String(pending.length);
    } catch { /* ignore */ }
  }

  function formatDate(iso: string | null): string {
    if (!iso) return '-';
    try {
      const d = new Date(iso);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    } catch { return iso; }
  }

  async function showUnknownTermsPanel(): Promise<void> {
    const backdrop = document.createElement('div');
    backdrop.className = 'fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4';

    const panel = document.createElement('div');
    panel.className = 'w-full max-w-4xl rounded-xl bg-white shadow-2xl dark:bg-gray-800 max-h-[90vh] flex flex-col';
    backdrop.appendChild(panel);

    // Header
    const header = document.createElement('div');
    header.className = 'flex items-center justify-between border-b border-gray-200 dark:border-gray-700 px-6 py-4 shrink-0';
    header.innerHTML = `
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">미확인 용어 관리</h3>
      <button class="panel-close text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl leading-none">&times;</button>
    `;
    panel.appendChild(header);

    // Filter tabs
    const filterBar = document.createElement('div');
    filterBar.className = 'flex gap-1 border-b border-gray-200 dark:border-gray-700 px-6 py-2 shrink-0';
    const filters: Array<{ label: string; value: string }> = [
      { label: '전체', value: '' },
      { label: '대기', value: 'pending' },
      { label: '승인', value: 'approved' },
      { label: '거부', value: 'rejected' },
    ];
    let activeFilter = 'pending';
    for (const f of filters) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = f.label;
      btn.dataset.filter = f.value;
      btn.className = 'px-3 py-1 rounded-md text-sm font-medium transition-colors '
        + (f.value === activeFilter
          ? 'bg-gray-200 text-gray-900 dark:bg-gray-600 dark:text-gray-100'
          : 'text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700');
      btn.addEventListener('click', () => {
        activeFilter = f.value;
        filterBar.querySelectorAll('button').forEach((b) => {
          b.className = 'px-3 py-1 rounded-md text-sm font-medium transition-colors '
            + (b.dataset.filter === activeFilter
              ? 'bg-gray-200 text-gray-900 dark:bg-gray-600 dark:text-gray-100'
              : 'text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700');
        });
        loadTerms();
      });
      filterBar.appendChild(btn);
    }
    panel.appendChild(filterBar);

    // Body (scrollable)
    const body = document.createElement('div');
    body.className = 'flex-1 overflow-y-auto px-6 py-4';
    panel.appendChild(body);

    async function loadTerms(): Promise<void> {
      body.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400 py-8 text-center">불러오는 중...</p>';
      try {
        const terms = await api.fetchUnknownTerms(
          activeFilter ? (activeFilter as 'pending' | 'approved' | 'rejected') : undefined,
        );
        if (terms.length === 0) {
          body.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400 py-8 text-center">항목이 없습니다.</p>';
          return;
        }
        renderTable(terms);
      } catch (err) {
        body.innerHTML = `<p class="text-sm text-red-500 py-8 text-center">오류: ${(err as Error).message}</p>`;
      }
    }

    function renderTable(terms: UnknownTermEntry[]): void {
      const table = document.createElement('table');
      table.className = 'w-full text-sm';
      table.innerHTML = `
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
            <th class="px-2 py-2">용어</th>
            <th class="px-2 py-2">추정 풀네임</th>
            <th class="px-2 py-2 hidden sm:table-cell">추정 설명</th>
            <th class="px-2 py-2 hidden md:table-cell">카테고리</th>
            <th class="px-2 py-2 text-center">횟수</th>
            <th class="px-2 py-2">상태</th>
            <th class="px-2 py-2 text-right">액션</th>
          </tr>
        </thead>
      `;
      const tbody = document.createElement('tbody');
      for (const t of terms) {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-gray-100 dark:border-gray-700/50 hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors';
        tr.innerHTML = `
          <td class="px-2 py-2 font-medium text-gray-900 dark:text-gray-100 whitespace-nowrap">${esc(t.term)}</td>
          <td class="px-2 py-2 text-gray-600 dark:text-gray-400">${esc(t.suggested_full_name ?? '-')}</td>
          <td class="px-2 py-2 text-gray-600 dark:text-gray-400 hidden sm:table-cell max-w-[200px] truncate">${esc(t.suggested_description ?? '-')}</td>
          <td class="px-2 py-2 text-gray-600 dark:text-gray-400 hidden md:table-cell">${esc(t.suggested_category ? (CATEGORY_LABELS[t.suggested_category] ?? t.suggested_category) : '-')}</td>
          <td class="px-2 py-2 text-center text-gray-600 dark:text-gray-400">${t.search_count}</td>
          <td class="px-2 py-2"><span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium ${STATUS_COLORS[t.status] ?? ''}">${STATUS_LABELS[t.status] ?? t.status}</span></td>
          <td class="px-2 py-2 text-right whitespace-nowrap"></td>
        `;
        const actionCell = tr.querySelector('td:last-child')!;

        if (t.status === 'pending') {
          const approveBtn = document.createElement('button');
          approveBtn.type = 'button';
          approveBtn.textContent = '승인';
          approveBtn.className = 'text-xs font-medium text-green-600 hover:text-green-800 dark:text-green-400 dark:hover:text-green-200 mr-2';
          approveBtn.addEventListener('click', () => showApproveDialog(t, () => { loadTerms(); refreshUnknownCount(); }));
          actionCell.appendChild(approveBtn);

          const rejectBtn = document.createElement('button');
          rejectBtn.type = 'button';
          rejectBtn.textContent = '거부';
          rejectBtn.className = 'text-xs font-medium text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-200 mr-2';
          rejectBtn.addEventListener('click', async () => {
            try {
              await api.rejectUnknownTerm(t.id);
              showToast('거부 처리되었습니다.');
              loadTerms();
              refreshUnknownCount();
            } catch (err) { showToast(`오류: ${(err as Error).message}`, true); }
          });
          actionCell.appendChild(rejectBtn);
        }

        const deleteBtn = document.createElement('button');
        deleteBtn.type = 'button';
        deleteBtn.textContent = '삭제';
        deleteBtn.className = 'text-xs font-medium text-gray-400 hover:text-red-600 dark:hover:text-red-400';
        deleteBtn.addEventListener('click', async () => {
          if (!confirm(`"${t.term}" 항목을 삭제하시겠습니까?`)) return;
          try {
            await api.deleteUnknownTerm(t.id);
            showToast('삭제되었습니다.');
            loadTerms();
            refreshUnknownCount();
          } catch (err) { showToast(`오류: ${(err as Error).message}`, true); }
        });
        actionCell.appendChild(deleteBtn);

        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      body.innerHTML = '';
      body.appendChild(table);
    }

    // Close handlers
    header.querySelector('.panel-close')!.addEventListener('click', () => backdrop.remove());
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) backdrop.remove(); });

    document.body.appendChild(backdrop);
    loadTerms();
  }

  function esc(str: string): string {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  // Approve dialog — pre-populated from AI suggestions
  async function showApproveDialog(ut: UnknownTermEntry, onDone: () => void): Promise<void> {
    const categories = await fetchCategories();
    const sorted = [...categories].sort((a, b) => a.order - b.order);
    const catOptions = sorted.map((c) =>
      `<option value="${c.code}" ${c.code === ut.suggested_category ? 'selected' : ''}>${c.name}</option>`
    ).join('');

    const backdrop = document.createElement('div');
    backdrop.className = 'fixed inset-0 z-[60] bg-black/50 flex items-center justify-center p-4';
    backdrop.innerHTML = `
      <div class="w-full max-w-md rounded-xl bg-white p-6 shadow-2xl dark:bg-gray-800 max-h-[80vh] overflow-y-auto">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">용어 승인 — <span class="text-blue-600 dark:text-blue-400">${esc(ut.term)}</span></h3>
        <form class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">용어 (ID)</label>
            <input name="id" type="text" required value="${esc(ut.term)}"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">풀네임</label>
            <input name="full_name" type="text" value="${esc(ut.suggested_full_name ?? '')}"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">카테고리</label>
            <select name="category" required
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100">
              ${catOptions}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">소분류</label>
            <input name="subcategory" type="text" placeholder="(선택)"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">설명</label>
            <textarea name="description" rows="2"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 resize-y">${esc(ut.suggested_description ?? '')}</textarea>
          </div>
          <div class="flex gap-2 pt-1">
            <button type="submit" class="flex-1 rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 transition-colors">승인 및 등록</button>
            <button type="button" class="approve-cancel flex-1 rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 dark:border-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">취소</button>
          </div>
        </form>
      </div>
    `;

    document.body.appendChild(backdrop);

    const form = backdrop.querySelector('form')!;
    backdrop.querySelector('.approve-cancel')!.addEventListener('click', () => backdrop.remove());
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) backdrop.remove(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const id = (fd.get('id') as string).trim();
      if (!id) return;

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitBtn.textContent = '등록 중...';
      submitBtn.disabled = true;

      try {
        await api.approveUnknownTerm(ut.id, {
          id,
          term: id,
          full_name: (fd.get('full_name') as string) || '',
          category: fd.get('category') as string,
          subcategory: (fd.get('subcategory') as string) || '',
          description: (fd.get('description') as string) || '',
          tags: [id],
        });
        backdrop.remove();
        showToast('용어가 승인 및 등록되었습니다.');
        onDone();
      } catch (err) {
        showToast(`오류: ${(err as Error).message}`, true);
        submitBtn.textContent = '승인 및 등록';
        submitBtn.disabled = false;
      }
    });
  }

  // Wire unknown terms button
  unknownTermsBtn.addEventListener('click', () => showUnknownTermsPanel());
</script>
